# ====================================
# Cadencea Web Environment Variables
# ====================================
# Copy this file to .env.local and fill in the values
#
# Multi-Repo Architecture:
# - This is the marketing website + account management portal
# - Connects to cadencea-api (REST API backend)
# - Uses Supabase for authentication
#
# NOTE: Cadencea Vault is a DESKTOP-ONLY application.
# This website does NOT provide vault/project management features.
# ====================================

# ===================
# Supabase Configuration
# ===================
# Get from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase Service Role Key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ===================
# Cadencea API Configuration
# ===================
# Backend API URL (cadencea-api)
# Development: http://localhost:8001/api
# Staging: https://api-staging.cadencea.app/api
# Production: https://api.cadencea.app/api
NEXT_PUBLIC_API_URL=http://localhost:8001/api

# ===================
# Environment
# ===================
NODE_ENV=development
CADENCEA_ENV=development  # development | staging | production

# Application URLs
NEXTAUTH_URL=http://localhost:3000

# ===================
# Desktop App Download URLs
# ===================
# Direct link to the current Cadencea Vault installer in B2.
# Update this on EVERY release (bump the version in the filename) — e.g.:
#   https://f003.backblazeb2.com/file/cadencea-products/updates/cadencea-vault/win/CadenceaVault+Setup+1.0.2.exe
#   https://f003.backblazeb2.com/file/cadencea-products/updates/cadencea-vault/mac/arm64/CadenceaVault-1.0.6-arm64.dmg
#   https://f003.backblazeb2.com/file/cadencea-products/updates/cadencea-vault/mac/x64/CadenceaVault-1.0.6-x64.dmg
# This is a NEXT_PUBLIC_ (build-time) variable: set it in Vercel and REDEPLOY for
# the change to reach the live site. Before deploying, confirm the URL returns
# HTTP 200 (curl -I "<url>") — a 404 here ships a dead download button.
# Leave empty to render the "Download for Windows" button in a disabled state.
NEXT_PUBLIC_WIN_DOWNLOAD_URL=
NEXT_PUBLIC_MAC_ARM64_DOWNLOAD_URL=
NEXT_PUBLIC_MAC_X64_DOWNLOAD_URL=

# ===================
# Optional: Database Connection
# ===================
# For direct DB access (usually not needed, use Supabase client instead)
# DATABASE_URL=postgresql://user:password@host:port/database

# ===================
# Optional: Email Configuration
# ===================
# For production newsletter functionality
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# FROM_EMAIL=noreply@cadencea.app

# ===================
# Optional: Error Monitoring
# ===================
# SENTRY_DSN=your-sentry-dsn
